DXCoreAdapterProperty :: enum u32 {
    InstanceLuid                  :: 0;
    DriverVersion                 :: 1;
    DriverDescription             :: 2;
    HardwareID                    :: 3;
    KmdModelVersion               :: 4;
    ComputePreemptionGranularity  :: 5;
    GraphicsPreemptionGranularity :: 6;
    DedicatedAdapterMemory        :: 7;
    DedicatedSystemMemory         :: 8;
    SharedSystemMemory            :: 9;
    AcgCompatible                 :: 10;
    IsHardware                    :: 11;
    IsIntegrated                  :: 12;
    IsDetachable                  :: 13;
    HardwareIDParts               :: 14;
    PhysicalAdapterCount          :: 15;
    AdapterEngineCount            :: 16;
    AdapterEngineName             :: 17;
}

DXCoreAdapterState :: enum u32 {
    IsDriverUpdateInProgress                      :: 0;
    AdapterMemoryBudget                           :: 1;
    AdapterMemoryUsageBytes                       :: 2;
    AdapterMemoryUsageByProcessBytes              :: 3;
    AdapterEngineRunningTimeMicroseconds          :: 4;
    AdapterEngineRunningTimeByProcessMicroseconds :: 5;
    AdapterTemperatureCelsius                     :: 6;
    AdapterInUseProcessCount                      :: 7;
    AdapterInUseProcessSet                        :: 8;
    AdapterEngineFrequencyHertz                   :: 9;
    AdapterMemoryFrequencyHertz                   :: 10;
}

DXCoreSegmentGroup :: enum u32 {
    Local    :: 0;
    NonLocal :: 1;
}

DXCoreNotificationType :: enum u32 {
    ListStale                         :: 0;
    NoLongerValid                     :: 1;
    BudgetChange                      :: 2;
    HardwareContentProtectionTeardown :: 3;

    AdapterListStale                         :: ListStale;
    AdapterNoLongerValid                     :: NoLongerValid;
    AdapterBudgetChange                      :: BudgetChange;
    AdapterHardwareContentProtectionTeardown :: HardwareContentProtectionTeardown;
}

DXCoreAdapterPreference :: enum u32 {
    Hardware        :: 0;
    MinimumPower    :: 1;
    HighPerformance :: 2;
}

DXCoreWorkload :: enum u32 {
    Graphics        :: 0;
    Compute         :: 1;
    Media           :: 2;
    MachineLearning :: 3;
}

DXCoreRuntimeFilterFlags :: enum u32 {
    None  :: 0;
    D3D11 :: 1;
    D3D12 :: 2;
}

DXCoreHardwareTypeFilterFlags :: enum u32 {
    None               :: 0;
    GPU                :: 1;
    ComputeAccelerator :: 2;
    NPU                :: 4;
    MediaAccelerator   :: 8;
}

DXCoreHardwareID :: struct {
    vendorID: u32;
    deviceID: u32;
    subSysID: u32;
    revision: u32;
}

DXCoreHardwareIDParts :: struct {
    vendorID:    u32;
    deviceID:    u32;
    subSystemID: u32;
    subVendorID: u32;
    revisionID:  u32;
}

DXCoreAdapterMemoryBudgetNodeSegmentGroup :: struct {
    nodeIndex:    u32;
    segmentGroup: DXCoreSegmentGroup;
}

DXCoreAdapterMemoryBudget :: struct {
    budget:                  u64;
    currentUsage:            u64;
    availableForReservation: u64;
    currentReservation:      u64;
}

DXCoreAdapterEngineIndex :: struct {
    physicalAdapterIndex: u32;
    engineIndex:          u32;
}

DXCoreEngineQueryInput :: struct {
    adapterEngineIndex: DXCoreAdapterEngineIndex;
    processId:          u32;
}

DXCoreEngineQueryOutput :: struct {
    runningTime:           u64;
    processQuerySucceeded: bool;
}

DXCoreMemoryType :: enum u32 {
    Dedicated :: 0;
    Shared    :: 1;
}

DXCoreMemoryUsage :: struct {
    committed: u64;
    resident:  u64;
}

DXCoreMemoryQueryInput :: struct {
    physicalAdapterIndex: u32;
    memoryType:           DXCoreMemoryType;
}

DXCoreProcessMemoryQueryInput :: struct {
    physicalAdapterIndex: u32;
    memoryType:           DXCoreMemoryType;
    processId:            u32;
}

DXCoreProcessMemoryQueryOutput :: struct {
    memoryUsage:           DXCoreMemoryUsage;
    processQuerySucceeded: bool;
}

DXCoreAdapterProcessSetQueryInput :: struct {
    arraySize:  u32;
    processIds: *u32;
}

DXCoreAdapterProcessSetQueryOutput :: struct {
    processesWritten: u32;
    processesTotal:   u32;
}

DXCoreEngineNamePropertyInput :: struct {
    adapterEngineIndex: DXCoreAdapterEngineIndex;
    engineNameLength:   u32;
    engineName:         *s16;
}

DXCoreEngineNamePropertyOutput :: struct {
    engineNameLength: u32;
}

DXCoreFrequencyQueryOutput :: struct {
    frequency:               u64;
    maxFrequency:            u64;
    maxOverclockedFrequency: u64;
}

PFN_DXCORE_NOTIFICATION_CALLBACK :: #type (notificationType: DXCoreNotificationType, object: *IUnknown, _context: *void) -> void #c_call;

