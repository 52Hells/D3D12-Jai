DML_TENSOR_DATA_TYPE :: enum s32 {
    UNKNOWN :: 0;
    FLOAT32 :: 1;
    FLOAT16 :: 2;
    UINT32  :: 3;
    UINT16  :: 4;
    UINT8   :: 5;
    INT32   :: 6;
    INT16   :: 7;
    INT8    :: 8;
