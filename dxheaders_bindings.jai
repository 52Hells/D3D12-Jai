DML_FEATURE_LEVEL :: enum s32 {
    _1_0 :: 4096;
    _2_0 :: 8192;
    _2_1 :: 8448;
    _3_0 :: 12288;
    _3_1 :: 12544;
    _4_0 :: 16384;
    _4_1 :: 16640;
    _5_0 :: 20480;
    _5_1 :: 20736;
    _5_2 :: 20992;
    _6_0 :: 24576;
    _6_1 :: 24832;
    _6_2 :: 25088;
    _6_3 :: 25344;
    _6_4 :: 25600;

    DML_FEATURE_LEVEL_1_0 :: _1_0;
    DML_FEATURE_LEVEL_2_0 :: _2_0;
    DML_FEATURE_LEVEL_2_1 :: _2_1;
    DML_FEATURE_LEVEL_3_0 :: _3_0;
    DML_FEATURE_LEVEL_3_1 :: _3_1;
    DML_FEATURE_LEVEL_4_0 :: _4_0;
    DML_FEATURE_LEVEL_4_1 :: _4_1;
    DML_FEATURE_LEVEL_5_0 :: _5_0;
    DML_FEATURE_LEVEL_5_1 :: _5_1;
    DML_FEATURE_LEVEL_5_2 :: _5_2;
    DML_FEATURE_LEVEL_6_0 :: _6_0;
    DML_FEATURE_LEVEL_6_1 :: _6_1;
    DML_FEATURE_LEVEL_6_2 :: _6_2;
    DML_FEATURE_LEVEL_6_3 :: _6_3;
    DML_FEATURE_LEVEL_6_4 :: _6_4;
}

DML_FEATURE :: enum s32 {
    TENSOR_DATA_TYPE_SUPPORT :: 0;

    FEATURE_LEVELS           :: 1;

    DML_FEATURE_TENSOR_DATA_TYPE_SUPPORT :: TENSOR_DATA_TYPE_SUPPORT;

    DML_FEATURE_FEATURE_LEVELS           :: FEATURE_LEVELS;
}

DML_FEATURE_QUERY_TENSOR_DATA_TYPE_SUPPORT :: struct {
    DataType: DML_TENSOR_DATA_TYPE;
}

DML_FEATURE_DATA_TENSOR_DATA_TYPE_SUPPORT :: struct {
    IsSupported: BOOL;
}

DML_FEATURE_QUERY_FEATURE_LEVELS :: struct {
    RequestedFeatureLevelCount: u32;
    RequestedFeatureLevels:     *DML_FEATURE_LEVEL;
}

DML_FEATURE_DATA_FEATURE_LEVELS :: struct {
    MaxSupportedFeatureLevel: DML_FEATURE_LEVEL;
}

DML_BINDING_TABLE_DESC :: struct {
    Dispatchable:        *IDMLDispatchable;
    CPUDescriptorHandle: D3D12_CPU_DESCRIPTOR_HANDLE;
    GPUDescriptorHandle: D3D12_GPU_DESCRIPTOR_HANDLE;
    SizeInDescriptors:   u32;
}

DML_EXECUTION_FLAGS :: enum_flags u32 {
    NONE                             :: 0x0;
    ALLOW_HALF_PRECISION_COMPUTATION :: 0x1;
    DISABLE_META_COMMANDS            :: 0x2;
    DESCRIPTORS_VOLATILE             :: 0x4;

    DML_EXECUTION_FLAG_NONE                             :: NONE;
    DML_EXECUTION_FLAG_ALLOW_HALF_PRECISION_COMPUTATION :: ALLOW_HALF_PRECISION_COMPUTATION;
    DML_EXECUTION_FLAG_DISABLE_META_COMMANDS            :: DISABLE_META_COMMANDS;
    DML_EXECUTION_FLAG_DESCRIPTORS_VOLATILE             :: DESCRIPTORS_VOLATILE;
}

DML_CREATE_DEVICE_FLAGS :: enum_flags u32 {
    NONE  :: 0x0;
    DEBUG :: 0x1;

    DML_CREATE_DEVICE_FLAG_NONE  :: NONE;
    DML_CREATE_DEVICE_FLAG_DEBUG :: DEBUG;
}

DMLCreateDevice :: (d3d12Device: *ID3D12Device, flags: DML_CREATE_DEVICE_FLAGS, riid: *IID, ppv: **void) -> HRESULT #foreign directml;
DMLCreateDevice :: (d3d12Device: *ID3D12Device, flags: DML_CREATE_DEVICE_FLAGS, riid: IID, ppv: **void) -> HRESULT #no_context {
    return DMLCreateDevice(d3d12Device, flags, *riid, ppv);
}

DMLCreateDevice1 :: (d3d12Device: *ID3D12Device, flags: DML_CREATE_DEVICE_FLAGS, minimumFeatureLevel: DML_FEATURE_LEVEL, riid: *IID, ppv: **void) -> HRESULT #foreign directml;
DMLCreateDevice1 :: (d3d12Device: *ID3D12Device, flags: DML_CREATE_DEVICE_FLAGS, minimumFeatureLevel: DML_FEATURE_LEVEL, riid: IID, ppv: **void) -> HRESULT #no_context {
    return DMLCreateDevice1(d3d12Device, flags, minimumFeatureLevel, *riid, ppv);
}

IDMLObject :: struct {
    #as using iunknown: IUnknown;
    #place iunknown; idmlobject_vtable: *IDMLObject_VTable;
}
IDMLObject_VTable :: struct #type_info_none {
    using iunknown: IUnknown_VTable;
    GetPrivateData: (this: *IDMLObject, guid: *GUID, dataSize: *u32, data: *void) -> HRESULT #cpp_method;
    SetPrivateData: (this: *IDMLObject, guid: *GUID, dataSize: u32, data: *void) -> HRESULT #cpp_method;
    SetPrivateDataInterface: (this: *IDMLObject, guid: *GUID, data: *IUnknown) -> HRESULT #cpp_method;
    SetName: (this: *IDMLObject, name: PCWSTR) -> HRESULT #cpp_method;
}
IDMLObject_GetPrivateData :: inline (this: *IDMLObject, guid: *GUID, dataSize: *u32, data: *void) -> HRESULT { return this.idmlobject_vtable.GetPrivateData(this, guid, dataSize, data); }
IDMLObject_SetPrivateData :: inline (this: *IDMLObject, guid: *GUID, dataSize: u32, data: *void) -> HRESULT { return this.idmlobject_vtable.SetPrivateData(this, guid, dataSize, data); }
IDMLObject_SetPrivateDataInterface :: inline (this: *IDMLObject, guid: *GUID, data: *IUnknown) -> HRESULT { return this.idmlobject_vtable.SetPrivateDataInterface(this, guid, data); }
IDMLObject_SetName :: inline (this: *IDMLObject, name: PCWSTR) -> HRESULT { return this.idmlobject_vtable.SetName(this, name); }

vtable :: (obj: *IDMLObject) -> *IDMLObject_VTable { return obj.idmlobject_vtable; }


IDMLDevice :: struct {
    #as using idmlobject: IDMLObject;
    #place idmlobject; idmldevice_vtable: *IDMLDevice_VTable;
}
IDMLDevice_VTable :: struct #type_info_none {
    using idmlobject: IDMLObject_VTable;
    CheckFeatureSupport: (this: *IDMLDevice, feature: DML_FEATURE, featureQueryDataSize: u32, featureQueryData: *void, featureSupportDataSize: u32, featureSupportData: *void) -> HRESULT #cpp_method;
    CreateOperator: (this: *IDMLDevice, desc: *DML_OPERATOR_DESC, riid: *IID, ppv: **void) -> HRESULT #cpp_method;
    CompileOperator: (this: *IDMLDevice, op: *IDMLOperator, flags: DML_EXECUTION_FLAGS, riid: *IID, ppv: **void) -> HRESULT #cpp_method;
    CreateOperatorInitializer: (this: *IDMLDevice, operatorCount: u32, operators: **IDMLCompiledOperator, riid: *IID, ppv: **void) -> HRESULT #cpp_method;
